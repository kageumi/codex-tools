{
  "name": "codex-tools",
  "private": true,
  "version": "0.7.13",
  "description": "管理 Codex 的 OpenAI 账号和第三方 Responses API 服务。",
  "author": "Codex Tools contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kageumi/codex-tools.git"
  },
  "homepage": "https://github.com/kageumi/codex-tools#readme",
  "bugs": {
    "url": "https://github.com/kageumi/codex-tools/issues"
  },
  "engines": {
    "bun": ">=1.4"
  },
  "packageManager": "bun@1.4.2",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "frontend:dev": "vite",
    "build": "vite build",
    "verify": "bun run verify:frontend && bun run verify:backend",
    "verify:frontend": "bun run version:check && bun run format:check && bun run lint && bun run typecheck && bun run test",
    "verify:backend": "bun run rust:format:check && bun run rust:lint && bun run rust:test",
    "check": "bun run verify && bun run build",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"*.{json,md,yml}\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"*.{json,md,yml}\" \".github/**/*.yml\"",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "bench": "bun run bench:frontend && bun run bench:backend",
    "bench:frontend": "vitest bench --run",
    "bench:backend": "cargo bench --manifest-path src-tauri/Cargo.toml --bench usage_log",
    "rust:format:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "rust:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --locked -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "version:check": "bun scripts/check-versions.mjs",
    "tauri": "tauri",
    "dist:win": "tauri build --target x86_64-pc-windows-msvc --bundles nsis",
    "dist:mac:arm64": "tauri build --target aarch64-apple-darwin --bundles app,dmg",
    "verify:mac:arm64": "codesign --verify --deep --strict --verbose=4 'src-tauri/target/aarch64-apple-darwin/release/bundle/macos/Codex Tools.app'"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2.8.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "^4.16.1",
    "tailwindcss": "^4",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^7.2.4",
    "vitest": "^4.0.18"
  }
}
